{
  "name": "free-chess-analysis",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "start": "node serve.mjs",
    "build": "npm run check && npm test",
    "check": "node tools/check-syntax.mjs",
    "calibration:collect": "node tools/calibrate-caps2.mjs collect --games 5000 --players 1200",
    "calibration:analyze": "node tools/calibrate-caps2.mjs analyze --depth 14",
    "calibration:fit": "node tools/calibrate-caps2.mjs fit",
    "test": "node --test"
  },
  "devDependencies": {
    "chess.js": "1.4.0",
    "stockfish": "19.0.1"
  }
}
